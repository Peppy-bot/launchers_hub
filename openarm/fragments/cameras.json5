// The three-episode-viewpoint camera set, tuned for the recorder (the
// headset selection retunes them for in-headset panels below). The
// adjustments bind the cameras into whichever recorder was selected; only
// the XR leader has camera slots of its own, so that attach is guarded on
// the shape.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // Wrist cameras: Arducam B0495 modules capturing their only mode the
      // host validated (yuyv 960x600 @ 30), republished as rgb8 for the
      // recorder. Instance ids become the dataset image keys
      // (observation.images.wrist_left / wrist_right). The /dev/openarm
      // names come from the host udev rule 99-openarm-cameras.rules (in
      // rules/, installed into /etc/udev/rules.d); the two cameras share a
      // USB serial, so the hub port is the identity.
      source: { name: "uvc_camera_linux", tag: "v1" },
      instances: [
        {
          instance_id: "wrist_left",
          arguments: {
            device_path: "/dev/openarm/left_wrist_cam",
            video: {
              frame_rate: 15,
              resolution: { width: 960, height: 600 },
              camera_encoding: "yuyv",
              topic_encoding: "rgb8",
            },
          },
        },
        {
          instance_id: "wrist_right",
          arguments: {
            device_path: "/dev/openarm/right_wrist_cam",
            video: {
              frame_rate: 15,
              resolution: { width: 960, height: 600 },
              camera_encoding: "yuyv",
              topic_encoding: "rgb8",
            },
          },
        },
      ],
    },
    {
      // Chest camera: ZED Mini as an rgbd producer (rectified left eye rgb8
      // + z16 depth in the same frame). Depth is published at
      // eye_resolution / downscale (640x360 here); min_depth_m sets the
      // disparity search range, so a lower floor costs matcher time. Needs
      // outbound network access at startup for the per-serial factory
      // calibration fetch.
      source: { name: "zed_camera", tag: "v1" },
      instances: [
        {
          instance_id: "chest",
          arguments: {
            device_path: "/dev/openarm/chest_cam",
            resolution: "hd720",
            frame_rate: 15,
            depth: { min_depth_m: 0.4, downscale: 2, block_size: 3 },
          },
        },
      ],
    },
  ],

  adjustments: [
    // Bind into whichever recorder was selected; lerobot today and any
    // option added to the axis tomorrow (its provides guarantees
    // recorder_inst). Skipped on its own when no recorder is launched.
    // Binding order fixes feature order in the dataset.
    { target: "recorder_inst",
      add_links: { color_cameras: ["wrist_left", "wrist_right"],
                   rgbd_cameras: ["chest"] } },
    // Shape guard: only the XR leader has camera slots (the panels the
    // headset relays anchor to the controllers).
    { target: "commander_inst", when: { robot_commander: "xr_commander" },
      add_links: { color_cameras: ["wrist_left", "wrist_right"],
                   rgbd_cameras: ["chest"] } },
    // Panels take the Arducams as raw yuyv (half of rgb8) and the chest a
    // deeper disparity floor. Rate and resolution stay with the camera rig;
    // the XR node relays at view_max_width.
    {
      when: { robot_commander: "xr_commander" },
      target: "wrist_left",
      set_arguments: {
        video: {
          frame_rate: 15,
          resolution: { width: 960, height: 600 },
          camera_encoding: "yuyv",
          topic_encoding: "yuyv",
        },
      },
    },
    {
      when: { robot_commander: "xr_commander" },
      target: "wrist_right",
      set_arguments: {
        video: {
          frame_rate: 15,
          resolution: { width: 960, height: 600 },
          camera_encoding: "yuyv",
          topic_encoding: "yuyv",
        },
      },
    },
    {
      when: { robot_commander: "xr_commander" },
      target: "chest",
      set_arguments: { depth: { min_depth_m: 0.45, downscale: 2, block_size: 5 } },
    },
  ],
}
